{
  "name": "@isothrum/editor",
  "version": "1.0.0",
  "description": "The Isothrum lab editor: a React canvas that draws infrastructure labs and compiles them to an Isoloom spec, plus the Isothrum WebAssembly engine. Shared by the Isothrum desktop app and isothrum.com.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/types/model.d.ts",
      "import": "./dist/model.js",
      "default": "./dist/model.js"
    },
    "./styles/globals.css": "./styles/globals.css",
    "./styles/theme.css": "./styles/theme.css",
    "./wasm/isothrum_wasm.js": "./wasm/isothrum_wasm.js",
    "./wasm/isothrum_wasm_bg.wasm": "./wasm/isothrum_wasm_bg.wasm",
    "./build-desktop-editor": "./scripts/build-desktop-editor.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "wasm",
    "desktop-editor",
    "scripts",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PUBLISHING.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:types && npm run build:desktop",
    "build:lib": "node scripts/build-lib.mjs",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:desktop": "node scripts/build-desktop-editor.mjs dist/desktop",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.12.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "roughjs": "^4.6.6",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4",
    "tsc-alias": "^1.8.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
